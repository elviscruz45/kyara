---
interface Props {
  badge?: string;
  script?: string;
  title: string;
  highlight?: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
}
const { badge, script, title, highlight, description, backHref, backLabel } = Astro.props;
---
<div class="relative overflow-hidden bg-gradient-to-b from-[#042940] to-[#053550] py-16 px-6">
  <div class="absolute right-0 top-0 w-72 h-72 bg-[#0B908C]/10 rounded-full blur-3xl"></div>
  <div class="max-w-4xl mx-auto relative z-10">
    {backHref && (
      <a href={backHref} class="inline-flex items-center gap-2 text-[#1BE4BF]/70 text-sm font-condensed mb-6 hover:text-[#1BE4BF] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        {backLabel ?? 'Volver'}
      </a>
    )}
    {badge && <span class="section-badge">{badge}</span>}
    {script && <p class="font-script text-[#1BE4BF] text-2xl mb-1">{script}</p>}
    <h1 class="font-display text-4xl lg:text-5xl font-bold text-white mb-4">
      {highlight
        ? <Fragment set:html={title.replace(highlight, `<span class="text-[#1BE4BF]">${highlight}</span>`)} />
        : title}
    </h1>
    {description && <p class="text-white/60 max-w-2xl leading-relaxed">{description}</p>}
  </div>
</div>
