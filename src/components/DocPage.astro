---
import PageHeader from './PageHeader.astro';

interface Consejo {
  titulo: string;
  texto: string;
}
interface Props {
  numero: string;
  titulo: string;
  subtitulo: string;
  descripcion: string;
  objetivos: string[];
  guiaImg: string;
  docImg: string;
  ilustracion: string;
  consejos: Consejo[];
  link: string;
  linkLabel: string;
  importante?: string;
}

const {
  numero, titulo, subtitulo, descripcion, objetivos,
  guiaImg, docImg, ilustracion, consejos, link, linkLabel, importante,
} = Astro.props;
---

<PageHeader
  badge={`Guía ${numero}`}
  script={subtitulo}
  title={titulo}
  backHref="/guia"
  backLabel="Todas las guías"
/>

<div class="bg-[#053550]">

  <!-- Intro -->
  <div class="py-16 px-6 border-b border-white/5">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-white/70 leading-relaxed text-lg mb-8">{descripcion}</p>
        <div class="space-y-3">
          <p class="text-xs font-condensed font-semibold tracking-widest text-[#1BE4BF]/70 uppercase mb-4">Objetivo de creación</p>
          {objetivos.map(obj => (
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 rounded-full bg-[#1BE4BF] mt-2 flex-shrink-0"></div>
              <p class="text-white/60 text-sm">{obj}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="flex justify-center">
        <div class="relative">
          <div class="absolute -inset-4 bg-[#1BE4BF]/10 rounded-2xl blur-xl"></div>
          <img src={docImg} alt={titulo} class="relative z-10 w-48 lg:w-64 object-contain drop-shadow-2xl rounded-xl" />
        </div>
      </div>
    </div>
  </div>

  <!-- Guide infographic -->
  <div class="py-16 px-6 border-b border-white/5 bg-gradient-to-b from-[#042940] to-[#053550]">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-condensed font-bold text-[#1BE4BF] text-sm tracking-widest uppercase text-center mb-8">
        Guía paso a paso
      </h2>
      <div class="bg-white/5 border border-white/10 rounded-2xl p-4 lg:p-6">
        <img src={guiaImg} alt={`Guía del ${titulo}`} class="w-full rounded-xl object-contain max-h-[600px]" />
      </div>
    </div>
  </div>

  <!-- Tips + Illustration -->
  <div class="py-16 px-6">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-condensed font-bold text-white text-xl mb-8 tracking-wide uppercase">
          Consejos al tramitar
        </h2>
        <div class="space-y-4 mb-8">
          {consejos.map(c => (
            <div class="flex gap-4 group">
              <div class="w-8 h-8 rounded-full bg-[#1BE4BF]/20 border border-[#1BE4BF]/30 flex items-center justify-center flex-shrink-0 group-hover:bg-[#1BE4BF]/30 transition-colors mt-0.5">
                <svg class="w-3.5 h-3.5 text-[#1BE4BF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <span class="font-condensed font-semibold text-white text-sm">{c.titulo}: </span>
                <span class="text-white/60 text-sm">{c.texto}</span>
              </div>
            </div>
          ))}
        </div>

        {importante && (
          <div class="bg-[#1BE4BF]/10 border border-[#1BE4BF]/30 rounded-xl p-4 mb-6">
            <p class="text-[#1BE4BF] text-xs font-condensed font-bold mb-1 tracking-wide uppercase">Importante</p>
            <p class="text-white/70 text-sm leading-relaxed">{importante}</p>
          </div>
        )}

        <a href={link} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#1BE4BF] text-[#053550] font-condensed font-bold text-sm tracking-wide px-6 py-3 rounded-full hover:bg-[#5AF6B6] transition-all duration-200">
          {linkLabel}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>

      <div class="flex flex-col items-center gap-6">
        <img src={ilustracion} alt="" class="w-72 lg:w-80 object-contain" />
        <!-- Nav to next doc -->
        <slot name="next" />
      </div>
    </div>
  </div>

</div>
