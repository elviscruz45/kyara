---
interface Consejo {
  titulo: string;
  texto: string;
}
interface Props {
  id: string;
  numero: string;
  titulo: string;
  subtitulo: string;
  descripcion: string;
  objetivos: string[];
  guiaImg: string;
  docImg: string;
  papelsImg: string;
  consejos: Consejo[];
  link: string;
  linkLabel: string;
  importante?: string;
  flip?: boolean;
}

const {
  id, numero, titulo, subtitulo, descripcion, objetivos,
  guiaImg, docImg, papelsImg, consejos, link, linkLabel,
  importante, flip = false,
} = Astro.props;
---

<section id={id} class="relative py-24 px-6 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-[#053550] to-[#042940]"></div>
  <!-- Accent blob -->
  <div class={`absolute ${flip ? 'left-0' : 'right-0'} top-1/3 w-72 h-72 bg-[#0B908C]/20 rounded-full blur-3xl`}></div>

  <div class="relative z-10 max-w-5xl mx-auto space-y-16">

    <!-- Intro -->
    <div class={`grid lg:grid-cols-2 gap-12 items-center ${flip ? 'lg:flex-row-reverse' : ''}`}>
      <div class={flip ? 'lg:order-2' : ''}>
        <span class="section-badge">{numero}</span>
        <p class="font-script text-[#1BE4BF] text-2xl mb-1">{subtitulo}</p>
        <h2 class="font-display text-4xl lg:text-5xl font-bold text-white mb-6">{titulo}</h2>
        <p class="text-white/70 leading-relaxed mb-8">{descripcion}</p>

        <div class="space-y-3">
          <p class="text-xs font-condensed font-semibold tracking-widest text-[#1BE4BF]/70 uppercase">Objetivo de creación</p>
          {objetivos.map(obj => (
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 rounded-full bg-[#1BE4BF] mt-2 flex-shrink-0"></div>
              <p class="text-white/60 text-sm">{obj}</p>
            </div>
          ))}
        </div>
      </div>

      <div class={`flex justify-center ${flip ? 'lg:order-1' : ''}`}>
        <div class="relative">
          <div class="absolute -inset-4 bg-[#1BE4BF]/10 rounded-2xl blur-xl"></div>
          <img src={docImg} alt={titulo} class="relative z-10 w-56 lg:w-72 object-contain drop-shadow-2xl rounded-xl" />
        </div>
      </div>
    </div>

    <!-- Guide infographic -->
    <div class="card p-4 lg:p-8">
      <h3 class="font-condensed font-bold text-[#1BE4BF] text-lg tracking-wide mb-6 text-center uppercase">
        Guía paso a paso
      </h3>
      <img src={guiaImg} alt={`Guía del ${titulo}`} class="w-full rounded-xl object-contain max-h-[500px]" />
    </div>

    <!-- Tips -->
    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <div>
        <h3 class="font-condensed font-bold text-white text-xl mb-6 tracking-wide uppercase">
          Consejos al tramitar
        </h3>
        <div class="space-y-4">
          {consejos.map(c => (
            <div class="flex gap-4 group">
              <div class="w-8 h-8 rounded-full bg-[#1BE4BF]/20 border border-[#1BE4BF]/30 flex items-center justify-center flex-shrink-0 group-hover:bg-[#1BE4BF]/30 transition-colors">
                <svg class="w-3.5 h-3.5 text-[#1BE4BF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <span class="font-condensed font-semibold text-white text-sm">{c.titulo}: </span>
                <span class="text-white/60 text-sm">{c.texto}</span>
              </div>
            </div>
          ))}
        </div>

        {importante && (
          <div class="mt-6 bg-[#1BE4BF]/10 border border-[#1BE4BF]/30 rounded-xl p-4">
            <p class="text-[#1BE4BF] text-xs font-condensed font-bold mb-1 tracking-wide uppercase">Importante</p>
            <p class="text-white/70 text-sm leading-relaxed">{importante}</p>
          </div>
        )}

        <div class="mt-6">
          <a href={link} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Iniciar trámite oficial
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="flex justify-center">
        <img src={papelsImg} alt={`Documentos de ${titulo}`} class="w-64 lg:w-80 object-contain opacity-90" />
      </div>
    </div>

  </div>
</section>
